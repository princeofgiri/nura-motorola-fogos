#!/bin/sh
# Fix battery detection in postmarketOS / UPower
# Unmount any stale dummy type if mounted
umount /sys/class/power_supply/qcom_battery/type 2>/dev/null || true
umount $(readlink -f /sys/class/power_supply/qcom_battery)/type 2>/dev/null || true


# Set Fast Charging Current (FCC) to 2.5A
FCC="/sys/bus/iio/devices/iio:device5/in_current_main_constant_charge_current_max_input"
if [ -f "$FCC" ]; then
    echo 2500000 > "$FCC" 2>/dev/null || true
fi

