ACTION=="add|change", SUBSYSTEM=="net", KERNEL=="rmnet_ipa*", ENV{ID_MM_QCOM_SOC}="1", ENV{ID_MM_PHYSDEV_UID}="qcom-soc", ENV{ID_MM_CANDIDATE}="1", ENV{ID_MM_DEVICE_PROCESS}="1", RUN+="/usr/bin/rmnet-setup rmnet_ipa0"
