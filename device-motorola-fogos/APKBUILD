8c03d60bc585fa5e196619f15522b77f9541f33868a81d427cc51661f57b5c5ddef2d99dfb81fa5e5408d82076cad8f412d88462295250fa53df7f407b98f2b9  kernel-cmdline.conf
8de6a560a9ba2a2128c7361204c8a20d31ecab27e8688a33d800b0cbe201f7270e2099e868db2e8caa95baab78d3a5e71a8e6e0a309894c10d4a95afa1f1b17d  modules-initfs
"
