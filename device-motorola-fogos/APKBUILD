# Reference: <https://postmarketos.org/devicepkg>
# Motorola Moto G34 5G (fogos). Downstream kernel 5.4 from LineageOS.
# Conventions follow in-tree device-motorola-dubai (same ABL/fastboot family):
# stock dtbo overlays target the stock DTB, so an empty dtbo image of the exact
# partition size (BOARD_DTBOIMG_PARTITION_SIZE := 25165824) is flashed instead.
# modules-initfs carries both touchscreen DLKM (chipone + ilitek, dual-source
# panels; unit tested so far is TXD/ILI9883C, DTB has a chipone_tddi node)
# so touch is already live in the initramfs debug shell.
maintainer="Fogos Porter <fogos@example.com>"
pkgname=device-motorola-fogos
pkgdesc="Motorola Moto G34 5G"
pkgver=3
pkgrel=20
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
replaces="postmarketos-base-ui-modemmanager-openrc rmtfs-openrc modemmanager-openrc"
options="!check !archcheck"
depends="
	linux-motorola-fogos
	firmware-motorola-fogos
	mesa-vulkan-freedreno
	make-dynpart-mappings
	mkbootimg
	msm-firmware-loader
	postmarketos-base
	soc-qcom
	eudev-libs
	python3
	unzip
"
makedepends="
	devicepkg-dev
	gcc
	musl-dev
	linux-headers
	libqmi-dev
	glib-dev
	pkgconf
"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	libqrtr-fix.c
	libmm-slot-fix.c
	pd-mapper.confd
	tqftpserv.confd
	rmtfs.confd
	modemmanager.confd
	00-subsys-ssr.start
	fogos-audio.initd
	display.start
	touchscreen.start
	modemmanager.initd
	modemmanager-wrapper.sh
	net-route.start
	99-subsys-ssr.rules
	99-touchscreen.rules
	99-fogos-charger.rules
	78-mm-rmnet-ipa.rules
	local-overrides.quirks
	00-kwin.sh
	99-fogos-power.conf
	android-log-catcher.c
	fogos-patch.py
	wifi-prepare.sh
	fogos-wifi.initd
	50-fogos.pa
	01-battery.start
	powerdevilrc
	fogos-powerd.py
	fogos-powerd.initd
	50-kgsl.rules
	rmnet-setup.c
	99-network-autoconnect.start
	20-audio-rlimits.conf
	org.kde.spacebar.Daemon.service
"

build() {
	devicepkg_build $startdir $pkgname

	# Empty dtbo image: the stock Android overlays must not be applied on
	# top of our DTB. Motorola's fastboot refuses "fastboot erase dtbo",
	# so a zero-filled image of the exact partition size is flashed instead.
	dd if=/dev/zero of="$srcdir/dtbo.img" bs=25165824 count=1

	# Build libqrtr-fix.so
	${CC:-gcc} $CFLAGS $CPPFLAGS $LDFLAGS -shared -fPIC -o "$srcdir/libqrtr-fix.so" "$srcdir/libqrtr-fix.c"

	# Build libmm-slot-fix.so
	${CC:-gcc} $CFLAGS $CPPFLAGS $LDFLAGS -shared -fPIC -o "$srcdir/libmm-slot-fix.so" "$srcdir/libmm-slot-fix.c" \
		$(pkg-config --cflags --libs qmi-glib) -ldl

	# Build android-log-catcher
	${CC:-gcc} $CFLAGS $CPPFLAGS $LDFLAGS -O2 -o "$srcdir/android-log-catcher" "$srcdir/android-log-catcher.c"

	# Build rmnet-setup
	${CC:-gcc} $CFLAGS $CPPFLAGS $LDFLAGS -O2 -o "$srcdir/rmnet-setup" "$srcdir/rmnet-setup.c"
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir/dtbo.img" "$pkgdir/boot/dtbo.img"

	# Fix libraries
	install -Dm755 "$srcdir/libqrtr-fix.so" "$pkgdir/usr/lib/libqrtr-fix.so"
	install -Dm755 "$srcdir/libmm-slot-fix.so" "$pkgdir/usr/lib/libmm-slot-fix.so"

	# OpenRC configs
	install -Dm644 "$srcdir/pd-mapper.confd" "$pkgdir/etc/conf.d/pd-mapper"
	install -Dm644 "$srcdir/tqftpserv.confd" "$pkgdir/etc/conf.d/tqftpserv"
	install -Dm644 "$srcdir/rmtfs.confd" "$pkgdir/etc/conf.d/rmtfs"
	install -Dm644 "$srcdir/modemmanager.confd" "$pkgdir/etc/conf.d/modemmanager"

	# Autostart scripts (OpenRC local.d - MUST BE EXECUTABLE 0755)
	install -Dm755 "$srcdir/00-subsys-ssr.start" "$pkgdir/etc/local.d/00-subsys-ssr.start"
	install -Dm755 "$srcdir/fogos-audio.initd" "$pkgdir/etc/init.d/fogos-audio"
	install -Dm755 "$srcdir/display.start" "$pkgdir/etc/local.d/display.start"
	install -Dm755 "$srcdir/touchscreen.start" "$pkgdir/etc/local.d/touchscreen.start"
	install -Dm755 "$srcdir/modemmanager.initd" "$pkgdir/etc/init.d/modemmanager"
	install -Dm755 "$srcdir/01-battery.start" "$pkgdir/etc/local.d/01-battery.start"
	install -Dm755 "$srcdir/net-route.start" "$pkgdir/etc/local.d/net-route.start"
	install -Dm755 "$srcdir/99-network-autoconnect.start" "$pkgdir/etc/local.d/99-network-autoconnect.start"

	# Udev rules and libinput quirks
	install -Dm644 "$srcdir/99-subsys-ssr.rules" "$pkgdir/etc/udev/rules.d/99-subsys-ssr.rules"
	install -Dm644 "$srcdir/99-touchscreen.rules" "$pkgdir/etc/udev/rules.d/99-touchscreen.rules"
	install -Dm644 "$srcdir/99-fogos-charger.rules" "$pkgdir/etc/udev/rules.d/99-fogos-charger.rules"
	install -Dm644 "$srcdir/78-mm-rmnet-ipa.rules" "$pkgdir/etc/udev/rules.d/78-mm-rmnet-ipa.rules"
	install -Dm644 "$srcdir/50-kgsl.rules" "$pkgdir/etc/udev/rules.d/50-kgsl.rules"
	install -Dm644 "$srcdir/local-overrides.quirks" "$pkgdir/etc/libinput/local-overrides.quirks"

	# Wayland / KWin display environment
	install -Dm755 "$srcdir/00-kwin.sh" "$pkgdir/etc/tinydm.d/env-wayland.d/00-kwin.sh"
	install -Dm755 "$srcdir/00-kwin.sh" "$pkgdir/etc/profile.d/kwin-drm.sh"

	# Elogind and KDE power configuration (prevent screen sleep crash)
	install -Dm644 "$srcdir/99-fogos-power.conf" "$pkgdir/etc/elogind/logind.conf.d/99-fogos-power.conf"
	install -Dm644 "$srcdir/powerdevilrc" "$pkgdir/etc/xdg/powerdevilrc"

	# Wi-Fi daemons, shims, and service
	install -Dm755 "$srcdir/android-log-catcher" "$pkgdir/usr/bin/android-log-catcher"
	install -Dm755 "$srcdir/fogos-patch.py" "$pkgdir/usr/lib/fogos-patch.py"
	install -Dm755 "$srcdir/wifi-prepare.sh" "$pkgdir/usr/share/fogos/wifi-prepare.sh"
	install -Dm755 "$srcdir/fogos-wifi.initd" "$pkgdir/etc/init.d/fogos-wifi"

	# Power and display wake daemon (power button & double tap to wake)
	install -Dm755 "$srcdir/fogos-powerd.py" "$pkgdir/usr/bin/fogos-powerd.py"
	install -Dm755 "$srcdir/fogos-powerd.initd" "$pkgdir/etc/init.d/fogos-powerd"

	# PulseAudio audio configuration and realtime limits
	install -Dm644 "$srcdir/50-fogos.pa" "$pkgdir/etc/pulse/default.pa.d/50-fogos.pa"
	install -Dm644 "$srcdir/20-audio-rlimits.conf" "$pkgdir/etc/security/limits.d/20-audio-rlimits.conf"

	# RMNET IPA WAN initialization helper
	install -Dm755 "$srcdir/rmnet-setup" "$pkgdir/usr/bin/rmnet-setup"

	# ModemManager wrapper and provisioning helper
	install -Dm755 "$srcdir/modemmanager-wrapper.sh" "$pkgdir/usr/share/fogos/modemmanager-wrapper.sh"

	# Spacebar messaging daemon D-Bus service
	install -Dm644 "$srcdir/org.kde.spacebar.Daemon.service" "$pkgdir/usr/share/dbus-1/services/org.kde.spacebar.Daemon.service"

	# OpenRC default runlevel service enablement
	mkdir -p "$pkgdir/etc/runlevels/default"
	ln -sf /etc/init.d/modemmanager "$pkgdir/etc/runlevels/default/modemmanager"
	ln -sf /etc/init.d/fogos-audio "$pkgdir/etc/runlevels/default/fogos-audio"
	ln -sf /etc/init.d/fogos-wifi "$pkgdir/etc/runlevels/default/fogos-wifi"
	ln -sf /etc/init.d/fogos-powerd "$pkgdir/etc/runlevels/default/fogos-powerd"
}
