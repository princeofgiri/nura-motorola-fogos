# Reference: <https://postmarketos.org/devicepkg>
# Motorola Moto G34 5G (fogos). Downstream kernel 5.4 from LineageOS.
# Conventions follow in-tree device-motorola-dubai (same ABL/fastboot family):
# stock dtbo overlays target the stock DTB, so an empty dtbo image of the exact
# partition size (BOARD_DTBOIMG_PARTITION_SIZE := 25165824) is flashed instead.
# modules-initfs carries both touchscreen DLKM (chipone + ilitek, dual-source
# panels; unit tested so far is TXD/ILI9883C, DTB has a chipone_tddi node)
# so touch is already live in the initramfs debug shell.
maintainer="Fogos Porter <fogos@example.com>"
pkgname=device-motorola-fogos
pkgdesc="Motorola Moto G34 5G"
pkgver=3
pkgrel=3
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-motorola-fogos
	make-dynpart-mappings
	mkbootimg
	msm-firmware-loader
	postmarketos-base
	soc-qcom
	eudev-libs
"
makedepends="
	devicepkg-dev
	gcc
	musl-dev
	linux-headers
	libqmi-dev
	glib-dev
	pkgconf
"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
	libqrtr-fix.c
	libmm-slot-fix.c
	pd-mapper.confd
	tqftpserv.confd
	rmtfs.confd
	modemmanager.confd
	display.start
	touchscreen.start
	rmtfs.start
	modem-setup.start
	net-route.start
	99-touchscreen.rules
	78-mm-rmnet-ipa.rules
	local-overrides.quirks
	00-kwin.sh
"

build() {
	devicepkg_build $startdir $pkgname

	# Empty dtbo image: the stock Android overlays must not be applied on
	# top of our DTB. Motorola's fastboot refuses "fastboot erase dtbo",
	# so a zero-filled image of the exact partition size is flashed instead.
	dd if=/dev/zero of="$srcdir/dtbo.img" bs=25165824 count=1

	# Build libqrtr-fix.so
	${CC:-gcc} $CFLAGS $CPPFLAGS $LDFLAGS -shared -fPIC -o "$srcdir/libqrtr-fix.so" "$srcdir/libqrtr-fix.c"

	# Build libmm-slot-fix.so
	${CC:-gcc} $CFLAGS $CPPFLAGS $LDFLAGS -shared -fPIC -o "$srcdir/libmm-slot-fix.so" "$srcdir/libmm-slot-fix.c" \
		$(pkg-config --cflags --libs qmi-glib) -ldl
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir/dtbo.img" "$pkgdir/boot/dtbo.img"

	# Fix libraries
	install -Dm755 "$srcdir/libqrtr-fix.so" "$pkgdir/usr/lib/libqrtr-fix.so"
	install -Dm755 "$srcdir/libmm-slot-fix.so" "$pkgdir/usr/lib/libmm-slot-fix.so"

	# OpenRC configs
	install -Dm644 "$srcdir/pd-mapper.confd" "$pkgdir/etc/conf.d/pd-mapper"
	install -Dm644 "$srcdir/tqftpserv.confd" "$pkgdir/etc/conf.d/tqftpserv"
	install -Dm644 "$srcdir/rmtfs.confd" "$pkgdir/etc/conf.d/rmtfs"
	install -Dm644 "$srcdir/modemmanager.confd" "$pkgdir/etc/conf.d/modemmanager"

	# Autostart scripts (OpenRC local.d - MUST BE EXECUTABLE 0755)
	install -Dm755 "$srcdir/display.start" "$pkgdir/etc/local.d/display.start"
	install -Dm755 "$srcdir/touchscreen.start" "$pkgdir/etc/local.d/touchscreen.start"
	install -Dm755 "$srcdir/rmtfs.start" "$pkgdir/etc/local.d/rmtfs.start"
	install -Dm755 "$srcdir/modem-setup.start" "$pkgdir/etc/local.d/modem-setup.start"
	install -Dm755 "$srcdir/net-route.start" "$pkgdir/etc/local.d/net-route.start"

	# Udev rules and libinput quirks
	install -Dm644 "$srcdir/99-touchscreen.rules" "$pkgdir/etc/udev/rules.d/99-touchscreen.rules"
	install -Dm644 "$srcdir/78-mm-rmnet-ipa.rules" "$pkgdir/etc/udev/rules.d/78-mm-rmnet-ipa.rules"
	install -Dm644 "$srcdir/local-overrides.quirks" "$pkgdir/etc/libinput/local-overrides.quirks"

	# Wayland / KWin display environment
	install -Dm755 "$srcdir/00-kwin.sh" "$pkgdir/etc/tinydm.d/env-wayland.d/00-kwin.sh"
	install -Dm755 "$srcdir/00-kwin.sh" "$pkgdir/etc/profile.d/kwin-drm.sh"
}
