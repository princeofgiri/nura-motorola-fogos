# Reference: <https://postmarketos.org/devicepkg>
# Motorola Moto G34 5G (fogos). Downstream kernel 5.4 from LineageOS.
# Conventions follow in-tree device-motorola-dubai (same ABL/fastboot family):
# stock dtbo overlays target the stock DTB, so an empty dtbo image of the exact
# partition size (BOARD_DTBOIMG_PARTITION_SIZE := 25165824) is flashed instead.
# modules-initfs carries both touchscreen DLKM (chipone + ilitek, dual-source
# panels; unit tested so far is TXD/ILI9883C, DTB has a chipone_tddi node)
# so touch is already live in the initramfs debug shell.
maintainer="Fogos Porter <fogos@example.com>"
pkgname=device-motorola-fogos
pkgdesc="Motorola Moto G34 5G"
pkgver=3
pkgrel=2
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	linux-motorola-fogos
	make-dynpart-mappings
	mkbootimg
	msm-firmware-loader
	postmarketos-base
	soc-qcom
"
makedepends="devicepkg-dev"
source="
	deviceinfo
	kernel-cmdline.conf
	modules-initfs
"

build() {
	devicepkg_build $startdir $pkgname

	# Empty dtbo image: the stock Android overlays must not be applied on
	# top of our DTB. Motorola's fastboot refuses "fastboot erase dtbo",
	# so a zero-filled image of the exact partition size is flashed instead.
	dd if=/dev/zero of="$srcdir/dtbo.img" bs=25165824 count=1
}

package() {
	devicepkg_package $startdir $pkgname

	install -Dm644 "$srcdir/dtbo.img" "$pkgdir/boot/dtbo.img"
}

