#!/sbin/openrc-run
description="Motorola Moto G34 5G Wi-Fi Daemon Stack"

depend() {
    need pd-mapper tqftpserv rmtfs
    before networkmanager
}

start_pre() {
    /usr/share/fogos/wifi-prepare.sh
}

start() {
    ebegin "Starting fogos Wi-Fi daemons"
    
    if ! pgrep -f android-log-catcher >/dev/null; then
        /usr/bin/android-log-catcher >/dev/null 2>&1 &
    fi

    if ! pgrep -f "vndservicemanager /dev/vndbinder" >/dev/null; then
        /vendor/bin/vndservicemanager /dev/vndbinder >/dev/null 2>&1 &
        sleep 0.5
    fi

    if ! pgrep -x pm-service >/dev/null; then
        /vendor/bin/pm-service >/dev/null 2>&1 &
        sleep 0.5
    fi

    if ! pgrep -x pm-proxy >/dev/null; then
        /vendor/bin/pm-proxy >/dev/null 2>&1 &
        sleep 0.5
    fi

    if ! pgrep -x cnss-daemon >/dev/null; then
        /vendor/bin/cnss-daemon -l >/dev/null 2>&1 &
        sleep 1
    fi

    if [ ! -d /sys/class/net/wlan0 ]; then
        modprobe wlan 2>/dev/null || true
        echo ON > /dev/wlan 2>/dev/null || true
    fi

    # Wait for wlan0 interface to be registered by WLAN driver
    for i in $(seq 1 30); do
        [ -d /sys/class/net/wlan0 ] && break
        sleep 0.5
    done

    # Bring up wlan0 link state
    ip link set wlan0 up 2>/dev/null || true

    # Unblock rfkill for Wi-Fi
    rfkill unblock wifi 2>/dev/null || true
    rfkill unblock all 2>/dev/null || true

    # Ensure NetworkManager state file has WirelessEnabled=true
    if [ -f /var/lib/NetworkManager/NetworkManager.state ]; then
        sed -i 's/WirelessEnabled=false/WirelessEnabled=true/' /var/lib/NetworkManager/NetworkManager.state 2>/dev/null || true
    fi

    eend 0
}

stop() {
    ebegin "Stopping fogos Wi-Fi daemons"
    killall -9 cnss-daemon pm-proxy pm-service vndservicemanager android-log-catcher 2>/dev/null || true
    eend 0
}
