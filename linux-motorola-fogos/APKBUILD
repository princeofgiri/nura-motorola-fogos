_config="config-$_flavor.$arch"
source="
	$pkgname-$_commit.tar.gz::https://github.com/LineageOS/$_repository/archive/$_commit.tar.gz
	$_config
	0001-techpack-camera-use-make-builtins-for-include-dirs.patch
"

builddir="$srcdir/$_repository-$_commit"
_outdir="out"

prepare() {
	default_prepare
	# Create the merged fogos DT source (base + overlay chain) directly:
	# BusyBox patch, used by abuild in the chroot, cannot create new
	# files, so this is not carried as a patch. The overlay chain uses
	# plain &label { } extension style (no fragment@/__overlay__), so it
	# compiles cleanly into one blob. The thin EVT/DVT wrappers are
	# skipped (they only carry qcom,msm-id/qcom,board-id for bootloader
	# overlay matching); EVT and DVT1 differ in nothing else.
	cat > "$builddir"/arch/arm64/boot/dts/vendor/qcom/blair-moto-fogos-pmos.dts <<-EOF
	// SPDX-License-Identifier: GPL-2.0-only
	/* Merged device tree for postmarketOS/Nura on Motorola fogos. */
	/dts-v1/;

	#include "blair-moto-fogos-base.dts"
	/* Drop the base's empty battery-data placeholder: the overlay chain
	 * defines its own populated qcom,battery-data (under /soc) with the
	 * same label, and dtc rejects the duplicate. */
	/ { /delete-node/ qcom,battery-data; };

	#include "blair-pm6125-fogos-common-overlay.dtsi"

	/* Touch power: the ilitek driver manages vdd+vcc supplies (both 1.8V)
	 * and leaves the chip unpowered without them; stock trees carry no
	 * supply links (the rail stays up via side effects there). Bind both
	 * to L9A (pm6125_l9, 1.8V, defined in this same overlay chain).
	 * chipone_tddi manages no regulators itself, so its node is untouched. */
	&qupv3_se0_spi {
		ilitek@1 {
			vdd-supply = <&L9A>;
			vcc-supply = <&L9A>;
		};
	};

	/* EXPERIMENT r9: modem boot trigger. subsys-pil-tz only registers;
	 * nothing in-kernel calls subsystem_get("modem") except adsp-loader
	 * when qcom,proc-img-to-load="modem" (ours says adsp2). Here we use
	 * the pon-depends-on mechanism instead: __subsystem_get() boots
	 * desc->pon_depends_on first (msm_subsystem_restart.c:824), and the
	 * property is parsed from the subsys DT node. So booting ADSP via
	 * `echo 1 > /sys/kernel/boot_adsp/boot` will PIL modem first.
	 * Reversible: drop this block if modem misbehaves. */
	&pil_lpass {
		qcom,pon-depends-on = "modem";
	};

	/* pstore ramoops rebalance (same total 0xBF800: console 256K->512K
	 * for Weston atomic-hang traces; pmsg/record shrunk accordingly).
	 * Regions below (WDOG_CPUCTX/TZLOG/MMI) untouched. */
	&reserved_memory {
		ramoops_mem {
			console-size = <0x80000>;
			pmsg-size = <0x20000>;
			record-size = <0x1f800>;
		};
	};
	EOF
	# Register it for CONFIG_FOGOS_DTB (sed instead of a patch hunk;
	# keeps the change next to the file it generates).
	sed -i 's|^blair-fogos-dvt1-overlay.dtbo-base := blair-moto-fogos-base.dtb$|&\
dtb-$(CONFIG_FOGOS_DTB) += blair-moto-fogos-pmos.dtb|' \
		"$builddir"/arch/arm64/boot/dts/vendor/qcom/Makefile
	grep -q '^dtb-$(CONFIG_FOGOS_DTB) += blair-moto-fogos-pmos.dtb$' \
		"$builddir"/arch/arm64/boot/dts/vendor/qcom/Makefile || \
		{ echo "ERROR: merged DTB registration failed"; exit 1; }
	test -f "$builddir"/arch/arm64/boot/dts/vendor/qcom/blair-moto-fogos-pmos.dts || \
		{ echo "ERROR: merged DTS creation failed"; exit 1; }
	REPLACE_GCCH=0 . downstreamkernel_prepare
}

build() {
	unset LDFLAGS
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1 ))-postmarketOS"
	# Explicitly build device trees: blair-moto-fogos-base.dtb is only a
	# side effect of the FOGOS dtbo overlay build (referenced via
	# "<overlay>.dtbo-base :=") and is not in dtb-y, so make sure the
	# dtbs (and hence the base dtb) actually get compiled.
	make O="$_outdir" ARCH="$_carch" CC="${CC:-gcc}" dtbs
}

package() {
	downstreamkernel_package "$builddir" "$pkgdir" "$_carch" \
		"$_flavor" "$_outdir"

	make dtbs_install O="$_outdir" ARCH="$_carch" \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs

	# Install the merged fogos DTB (base + overlay chain, generated in
	# prepare()). This must match deviceinfo_dtb
	# ("vendor/qcom/blair-moto-fogos-pmos") in device-motorola-fogos. (dtbs_install already covers it since it
	# is in dtb-y; installed explicitly as a guarantee.)
	install -Dm644 "$builddir"/"$_outdir"/arch/"$_carch"/boot/dts/vendor/qcom/blair-moto-fogos-pmos.dtb \
		"$pkgdir"/boot/dtbs/vendor/qcom/blair-moto-fogos-pmos.dtb

	# Vendor DLKM modules (wlan, camera, audio, touchscreen, ...): without
	# these the corresponding hardware stays dead.
	make modules_install O="$_outdir" ARCH="$_carch" \
		INSTALL_MOD_PATH="$pkgdir"/usr \
		INSTALL_MOD_STRIP=1

	rm -f "$pkgdir"/usr/lib/modules/*/build "$pkgdir"/usr/lib/modules/*/source
}

