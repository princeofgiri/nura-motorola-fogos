From c2173d6c1fd651c48e1accf5bb4605774b46ad6b Mon Sep 17 00:00:00 2001
From: Fogos Porter <fogos@example.com>
Date: Wed, 14 Oct 2026 10:58:30 +0700
Subject: [PATCH] libweston: tolerate drivers reporting a format twice

Some downstream DRM drivers (e.g. Qualcomm msm_drm as shipped in
Motorola SM6375 vendor kernels) list the same pixel format twice while
probing planes. Upstream treats that as a fatal assert; reuse the
existing entry instead so the compositor can start on such drivers.
---
 libweston/drm-formats.c | 8 +++++---
 1 file changed, 5 insertions(+), 3 deletions(-)

diff --git a/libweston/drm-formats.c b/libweston/drm-formats.c
index 6bc08b5..b9afa46 100644
--- a/libweston/drm-formats.c
+++ b/libweston/drm-formats.c
@@ -115,7 +115,8 @@ weston_drm_format_array_replace(struct weston_drm_format_array *formats,
 /**
  * Add format to weston_drm_format_array
  *
- * Adding repeated formats is considered an error.
+ * Adding a repeated format reuses the existing entry (some drivers report
+ * the same format twice).
  *
  * @param formats The weston_drm_format_array that receives the format
  * @param format The format to add to the array
@@ -127,8 +128,9 @@ weston_drm_format_array_add_format(struct weston_drm_format_array *formats,
 {
 	struct weston_drm_format *fmt;
 
-	/* We should not try to add repeated formats to an array. */
-	assert(!weston_drm_format_array_find_format(formats, format));
+	fmt = weston_drm_format_array_find_format(formats, format);
+	if (fmt)
+		return fmt;
 
 	fmt = wl_array_add(&formats->arr, sizeof(*fmt));
 	if (!fmt) {
